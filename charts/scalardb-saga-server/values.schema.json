{
    "$schema": "http://json-schema.org/schema#",
    "type": "object",
    "properties": {
        "fullnameOverride": {
            "type": "string"
        },
        "nameOverride": {
            "type": "string"
        },
        "scalarDbSagaServer": {
            "type": "object",
            "properties": {
                "affinity": {
                    "type": "object"
                },
                "configMapNames": {
                    "type": "object",
                    "properties": {
                        "sagaDefinitions": {
                            "type": "string"
                        },
                        "sagaServices": {
                            "type": "string"
                        }
                    }
                },
                "deploymentAnnotations": {
                    "type": "object"
                },
                "deploymentLabels": {
                    "type": "object"
                },
                "extraVolumeMounts": {
                    "type": "array"
                },
                "extraVolumes": {
                    "type": "array"
                },
                "image": {
                    "type": "object",
                    "properties": {
                        "pullPolicy": {
                            "type": "string"
                        },
                        "repository": {
                            "type": "string"
                        },
                        "tag": {
                            "type": "string"
                        }
                    }
                },
                "imagePullSecrets": {
                    "type": "array"
                },
                "javaOpts": {
                    "type": "string"
                },
                "logLevel": {
                    "type": "string"
                },
                "nodeSelector": {
                    "type": "object"
                },
                "podAnnotations": {
                    "type": "object"
                },
                "podLabels": {
                    "type": "object"
                },
                "podSecurityContext": {
                    "type": "object",
                    "properties": {
                        "seccompProfile": {
                            "type": "object",
                            "properties": {
                                "type": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "properties": {
                    "type": "object",
                    "properties": {
                        "scalar": {
                            "type": "object",
                            "properties": {
                                "db": {
                                    "type": "object",
                                    "properties": {
                                        "contact_points": {
                                            "type": "string"
                                        },
                                        "password": {
                                            "type": "string"
                                        },
                                        "saga": {
                                            "type": "object",
                                            "properties": {
                                                "server": {
                                                    "type": "object",
                                                    "properties": {
                                                        "tls": {
                                                            "type": "object",
                                                            "properties": {
                                                                "enabled": {
                                                                    "type": "boolean"
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        },
                                        "storage": {
                                            "type": "string"
                                        },
                                        "username": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "replicaCount": {
                    "type": "integer"
                },
                "resources": {
                    "type": "object"
                },
                "secretNames": {
                    "type": "array"
                },
                "securityContext": {
                    "type": "object",
                    "properties": {
                        "allowPrivilegeEscalation": {
                            "type": "boolean"
                        },
                        "capabilities": {
                            "type": "object",
                            "properties": {
                                "drop": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    }
                                }
                            }
                        },
                        "runAsNonRoot": {
                            "type": "boolean"
                        }
                    }
                },
                "serverOpts": {
                    "type": "string"
                },
                "service": {
                    "type": "object",
                    "properties": {
                        "annotations": {
                            "type": "object"
                        },
                        "grpc": {
                            "type": "object",
                            "properties": {
                                "port": {
                                    "type": "integer"
                                }
                            }
                        },
                        "http": {
                            "type": "object",
                            "properties": {
                                "port": {
                                    "type": "integer"
                                }
                            }
                        },
                        "type": {
                            "type": "string"
                        }
                    }
                },
                "serviceAccount": {
                    "type": "object",
                    "properties": {
                        "annotations": {
                            "type": "object"
                        },
                        "automount": {
                            "type": "boolean"
                        },
                        "create": {
                            "type": "boolean"
                        },
                        "name": {
                            "type": "string"
                        }
                    }
                },
                "tls": {
                    "type": "object",
                    "properties": {
                        "egress": {
                            "type": "object",
                            "properties": {
                                "secretName": {
                                    "type": "string"
                                }
                            }
                        },
                        "server": {
                            "type": "object",
                            "properties": {
                                "secretName": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "tolerations": {
                    "type": "array"
                }
            }
        }
    }
}
